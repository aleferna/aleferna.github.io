---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getPublications } from '../lib/content';

const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications" description="Publications and preprints.">
  <h1>Publications</h1>
  <p class="page-intro">
    Peer-reviewed papers and preprints.
  </p>

  {
    years.map((year) => (
      <section>
        <h2 class="year">{year}</h2>
        <ul class="plain-list">
          {pubs
            .filter((p) => p.data.year === year)
            .map((pub) => (
              <PublicationItem pub={pub} />
            ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .year {
    font-size: 1.1rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    margin-top: 2rem;
  }
</style>
