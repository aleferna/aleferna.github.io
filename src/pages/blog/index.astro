---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="Blog" description="Notes and writing.">
  <h1 data-cpm-group="title">Blog</h1>
  <p class="page-intro" data-cpm-group="title">Notes on research, tools, and things I'm learning.</p>

  {
    years.map((year) => (
      <section class="year-group" data-cpm-barrier>
        <h2 class="year">{year}</h2>
        <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} />
      </section>
    ))
  }
</BaseLayout>

<style>
  .year {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
  }

  /* Each year (heading + posts) is one cell: tight spacing inside, the large gap between years. */
  .year-group + .year-group {
    margin-top: var(--gap-large);
  }

  .year-group :global(.posts li) {
    padding: 0.4rem 0;
    gap: 1rem;
  }
</style>
