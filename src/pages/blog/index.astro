---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="Blog" description="Notes and writing.">
  <h1>Blog</h1>
  <p class="page-intro">Notes on research, tools, and things I'm learning.</p>

  {
    years.map((year) => (
      <section>
        <h2 class="year">{year}</h2>
        <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === year)} />
      </section>
    ))
  }
</BaseLayout>

<style>
  .year {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 2rem 0 0.5rem;
  }
</style>
