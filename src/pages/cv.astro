---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

// The CV is a PDF in /public (path set by `cvPdf` in src/config.ts).
const pdf = SITE.cvPdf;
const hasPdf = Boolean(pdf) && fs.existsSync(path.join(process.cwd(), 'public', pdf));
---

<BaseLayout title="CV" description={`Curriculum vitae of ${SITE.name}.`}>
  <div class="cv-head">
    <h1>Curriculum Vitae</h1>
    {
      hasPdf && (
        <p class="actions small">
          <a href={pdf} target="_blank" rel="noopener">Open in new tab</a>
          <a href={pdf} download>Download PDF</a>
        </p>
      )
    }
  </div>

  {
    hasPdf ? (
      <object class="cv-embed" data={`${pdf}#view=FitH`} type="application/pdf" aria-label="CV (PDF)">
        <p>
          Your browser can't display the PDF here. <a href={pdf}>Download the CV</a> instead.
        </p>
      </object>
    ) : (
      <p class="muted">CV coming soon.</p>
    )
  }
</BaseLayout>

<style>
  .cv-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    margin: 0;
  }

  .cv-embed {
    display: block;
    width: 100%;
    height: 85vh;
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }
</style>
