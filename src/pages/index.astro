---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PublicationItem from '../components/PublicationItem.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts, getPublications } from '../lib/content';

const hasAvatar = Boolean(SITE.avatar) && fs.existsSync(path.join(process.cwd(), 'public', SITE.avatar));
const selectedPubs = (await getPublications()).filter((p) => p.data.featured).slice(0, 4);
const recentPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    {hasAvatar && <img class="avatar" src={SITE.avatar} alt={`Photo of ${SITE.name}`} width="112" height="112" />}
    <div>
      <h1>{SITE.name}</h1>
      <p class="role">
        {SITE.role} · <a href={SITE.affiliationUrl}>{SITE.affiliation}</a>
        {SITE.location && <span class="muted"> · {SITE.location}</span>}
      </p>
    </div>
  </section>

  <section class="bio">
    <p>
      I am a theoretical biologist interested in the evolution of biological complexity. Life
      exists in different levels of organisation, and my current research aims to understand how transitions
      between these levels happen — i.e., how molecules organise to form cells, how cells organise to
      form organisms, how organisms organise to form populations, and so on.
    </p>
    <SocialLinks />
  </section>

  {
    selectedPubs.length > 0 && (
      <section>
        <h2>Selected publications</h2>
        <ul class="plain-list">
          {selectedPubs.map((pub) => (
            <PublicationItem pub={pub} />
          ))}
        </ul>
        <p class="small">
          <a href="/publications/">All publications →</a>
        </p>
      </section>
    )
  }

  {
    recentPosts.length > 0 && (
      <section>
        <h2>Recent writing</h2>
        <PostList posts={recentPosts} />
        <p class="small more">
          <a href="/blog/">All posts →</a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .role {
    margin: 0;
    color: var(--muted);
  }

  .bio {
    margin-bottom: 1rem;
  }

  .bio :global(.social) {
    margin-top: 1.25rem;
  }

  .more {
    margin-top: 0.75rem;
  }

  @media (max-width: 480px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
