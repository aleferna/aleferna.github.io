---
// Cellular Potts model running behind the page content (inside <main>, so the top and bottom
// bars are left out). Every "part" of the layout (the innermost block-level elements:
// paragraphs, headings, list items, images, buttons, ...) is projected onto the lattice as a
// rectangle of "chemical", 1 inside and fading to 0 over DITHER_RADIUS sites around it. Each
// rectangle gets one gigantic cell that is attracted to its own chemical (see GIANT below);
// small Act-model cells move around between them (approach adapted from the butterfly example
// in github.com/aleferna/cellula-rs).
//
// Options (query string, for experimenting):
//   ?cpm=debug  outline each element's rectangle, shade the chemical field, and expose the
//               model as `window.cpm` (and the field as `window.cpmField()`)
//   ?cpm=off    disable the simulation
//
// Per element:
//   data-cpm-barrier  treat this element as one rectangle (don't look inside it)
//   data-cpm-skip     ignore this element and its children
//   data-cpm-group="name"  elements with the same group name form one rectangle together (the
//                     smallest rectangle containing all of them), even if they are far apart
---

<div id="cpm-layer" aria-hidden="true">
  <canvas id="cpm-canvas"></canvas>
</div>

<script>
  /* eslint-disable @typescript-eslint/no-explicit-any */

  // ---- Model settings -----------------------------------------------------------------------
  const SCALE = 4; // CSS pixels per lattice site
  // Extra lattice sites around each layout rectangle: content blocks get a wider margin than the
  // social links.
  const PAD = 2;
  const PAD_SMALL = 1;
  const SMALL_PAD_SELECTOR = '.social';
  const DENSITY = 0.12; // fraction of the free lattice to fill with cells
  const MAX_CELLS = 125;
  const MCS_PER_FRAME = 1;

  const BG = 0;
  const GIANT = 1; // one gigantic cell per layout rectangle
  const CELL = 2; // the small, free-roaming cells

  // Giant cells: each one is attracted to the "chemical" of its own rectangle, which is 1
  // inside the rectangle and fades to 0 over DITHER_RADIUS sites around it. The chemical works
  // as a potential, like the shape fill in cellula-rs' butterfly example: a giant gaining a
  // site lowers the energy by CHEM_LAMBDA × c, losing one raises it by the same amount. Giants
  // have no Act dynamics; their target area is the area of their rectangle (their own volume
  // term, since Artistoo's volume constraint only supports one target per cell kind).
  // Small cells keep the Act model and ignore the chemical.
  const CHEM_LAMBDA = 50;
  const DITHER_RADIUS = 8; // sites around each rectangle over which the chemical fades to 0
  const GIANT_LAMBDA_V = 2;
  const GIANT_VOLUME_FACTOR = 1.1; // giant target volume = this × the area of its rectangle
  // Each element's rectangle is widened around its centre by √RECT_GROWTH (the width a 20%
  // larger area would have), and grown by a fixed RECT_GROW_Y px at the top and bottom. A
  // fixed vertical growth keeps the gaps between stacked cells the same everywhere; scaling the
  // height made tall blocks eat more of the gap than short ones.
  // Cursor attractor (header toggle): small cells are pulled towards the cursor with Artistoo's
  // AttractionPointConstraint; ΔH = -ATTRACT_LAMBDA × cos(angle between copy and cursor).
  const ATTRACT_LAMBDA = 60;
  const RECT_GROWTH = 1.2;
  const RECT_GROW_Y = 8;
  // Corner radius of the rectangles (lattice sites, × SCALE px), capped at half the shorter side.
  const CORNER_RADIUS = 6;

  // Target cell area (lattice sites) and perimeter: 1.1 × the perimeter of a circle with that
  // area, with Artistoo's perimeter counted as 3 per unit of boundary length.
  const AREA = 200;
  const PERIMETER = 180;

  const CONF = {
    torus: [false, false],
    T: 20,
    // Adhesion energies: background, giant, small cell
    // (small–giant is slightly higher than small–background, so small cells mildly avoid giants)
    J: [
      [0, 20, 20],
      [20, 40, 40],
      [20, 40, 40],
    ],
    LAMBDA_V: [0, 0, 50],
    V: [0, 0, AREA],
    LAMBDA_P: [0, 0, 2],
    P: [0, 0, PERIMETER],
    // Act model: recently extended pixels carry "activity" that decays over MAX_ACT steps, and
    // cells favour extending from active regions.
    LAMBDA_ACT: [0, 0, 300],
    MAX_ACT: [0, 0, 20],
    ACT_MEAN: 'geometric',
  };


  // Elements that are always one rectangle (their contents are not inspected).
  const ATOMIC = new Set(['IMG', 'SVG', 'svg', 'OBJECT', 'IFRAME', 'VIDEO', 'BUTTON', 'INPUT', 'SELECT', 'TEXTAREA', 'PRE', 'TABLE']);
  const IGNORED = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE', 'BR']);

  const mode = new URLSearchParams(location.search).get('cpm');
  // Startup timing (ms since navigation); logged to the console with ?cpm=debug.
  const timings: Record<string, number> = { script: Math.round(performance.now()) };
  const mark = (name: string) => {
    if (!(name in timings)) timings[name] = Math.round(performance.now());
  };
  // On/off state lives in data-sim on <html> (set early in BaseLayout, flipped by the header
  // toggle); reduced motion and ?cpm=off are folded into it there.
  const simOn = () => document.documentElement.dataset.sim !== 'off';
  let started = false;
  let running = false;
  let attractor: any = null; // the AttractionPointConstraint; its conf is updated every frame
  let pointer: [number, number] | null = null; // last cursor position (client coordinates)
  addEventListener('pointermove', (e) => (pointer = [e.clientX, e.clientY]), { passive: true });
  addEventListener('pointerdown', (e) => (pointer = [e.clientX, e.clientY]), { passive: true });
  document.documentElement.addEventListener('pointerleave', () => (pointer = null));

  const layer = document.getElementById('cpm-layer') as HTMLDivElement;
  const canvas = document.getElementById('cpm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  // The element the simulation covers (<main>); layout parts inside it become chemical sources.
  const container = layer.parentElement as HTMLElement;

  let CPM: any;
  let C: any = null;
  let W = 0;
  let H = 0;
  type Rect = { x0: number; y0: number; x1: number; y1: number };
  let field = new Float32Array(0); // combined chemical of all rectangles (only shown in debug mode)
  let rects: Rect[] = [];
  let giantIds: number[] = []; // giantIds[k] lives on rects[k]
  const giantRect = new Map<number, Rect>();
  let image: ImageData | null = null;
  let colors = { fill: [0, 0, 0, 0], edge: [0, 0, 0, 0], giantFill: [0, 0, 0, 0], giantEdge: [0, 0, 0, 0], field: [0, 0, 0, 0] };

  function loadArtistoo(): Promise<any> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = '/vendor/artistoo.min.js';
      s.onload = () => resolve((window as any).CPM);
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  // ---- Layout -> rectangles ----------------------------------------------------------------
  function isInlineDisplay(d: string) {
    return d === 'inline' || d.startsWith('inline-') || d === 'ruby';
  }

  function collectElements(el: Element, out: Element[]) {
    if (el === layer || el === debugLayer || IGNORED.has(el.tagName) || el.hasAttribute('data-cpm-skip')) return;
    const cs = getComputedStyle(el);
    if (cs.display === 'none' || cs.visibility === 'hidden') return;

    if (ATOMIC.has(el.tagName) || el.hasAttribute('data-cpm-barrier') || el.hasAttribute('data-cpm-group')) {
      out.push(el);
      return;
    }

    const kids = [...el.children].filter((k) => !IGNORED.has(k.tagName));
    const hasBlockKid = kids.some((k) => {
      if (ATOMIC.has(k.tagName)) return false;
      const d = getComputedStyle(k).display;
      return d !== 'none' && !isInlineDisplay(d);
    });

    if (!hasBlockKid && cs.display !== 'contents') {
      // Innermost block (or a stray inline element): one rectangle for the whole part.
      if (el.textContent?.trim() || kids.length) out.push(el);
      return;
    }
    for (const k of kids) collectElements(k, out);
  }

  // Re-measure whenever the page or any layout element changes size (e.g. when a font finishes
  // loading and text gets wider without the page itself changing size).
  let pending = 0;
  const observed = new Set<Element>();
  const resizeObserver = new ResizeObserver(() => {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(sync);
  });

  function watch(elements: Element[]) {
    const next = new Set(elements);
    for (const el of observed) {
      if (!next.has(el)) {
        resizeObserver.unobserve(el);
        observed.delete(el);
      }
    }
    for (const el of next) {
      if (!observed.has(el)) {
        resizeObserver.observe(el);
        observed.add(el);
      }
    }
  }

  function layoutRects() {
    const origin = layer.getBoundingClientRect();
    const elements: Element[] = [];
    collectElements(container, elements);
    watch([container, ...elements]);
    const parts = elements
      .map((el) => ({
        r: el.getBoundingClientRect(),
        pad: el.closest(SMALL_PAD_SELECTOR) ? PAD_SMALL : PAD,
        group: el.getAttribute('data-cpm-group'),
      }))
      .filter(({ r }) => r.width > 0 && r.height > 0)
      // Drop elements that sit outside the page (e.g. the off-screen skip link).
      .filter(({ r }) => r.right > origin.left && r.left < origin.right && r.bottom > origin.top && r.top < origin.bottom);

    // Merge each data-cpm-group into the bounding box of its members.
    const merged: { r: { left: number; top: number; right: number; bottom: number }; pad: number }[] = [];
    const groups = new Map<string, (typeof merged)[number]>();
    for (const { r, pad, group } of parts) {
      const box = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
      if (!group) {
        merged.push({ r: box, pad });
      } else if (!groups.has(group)) {
        const entry = { r: box, pad };
        groups.set(group, entry);
        merged.push(entry);
      } else {
        const g = groups.get(group)!.r;
        g.left = Math.min(g.left, box.left);
        g.top = Math.min(g.top, box.top);
        g.right = Math.max(g.right, box.right);
        g.bottom = Math.max(g.bottom, box.bottom);
      }
    }

    // Widen each rectangle around its centre by √RECT_GROWTH; add RECT_GROW_Y px top and bottom.
    const k = Math.sqrt(RECT_GROWTH);
    return merged.map(({ r, pad }) => {
      const cx = (r.left + r.right) / 2 - origin.left;
      const cy = (r.top + r.bottom) / 2 - origin.top;
      const hw = ((r.right - r.left) * k) / 2;
      const hh = (r.bottom - r.top) / 2 + RECT_GROW_Y;
      return {
        x0: Math.max(0, Math.floor((cx - hw) / SCALE) - pad),
        y0: Math.max(0, Math.floor((cy - hh) / SCALE) - pad),
        x1: Math.min(W - 1, Math.ceil((cx + hw) / SCALE) + pad - 1),
        y1: Math.min(H - 1, Math.ceil((cy + hh) / SCALE) + pad - 1),
      };
    });
  }

  // ---- Model ------------------------------------------------------------------------------
  function idx(x: number, y: number) {
    return (x << C.grid.Y_BITS) | y;
  }

  // Debug overlay: one rounded rectangle per layout element, drawn above the page.
  let debugLayer: HTMLDivElement | null = null;

  function drawDebugBoxes(rects: { x0: number; y0: number; x1: number; y1: number }[]) {
    if (!debugLayer) {
      debugLayer = document.createElement('div');
      debugLayer.setAttribute('aria-hidden', 'true');
      debugLayer.style.cssText = 'position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1000';
      container.appendChild(debugLayer);
    }
    debugLayer.replaceChildren(
      ...rects.map((r) => {
        const box = document.createElement('div');
        box.style.cssText =
          `position:absolute;box-sizing:border-box;border:1.5px solid rgba(220,50,90,.85);border-radius:${cornerRadius(r) * SCALE}px;` +
          `left:${r.x0 * SCALE}px;top:${r.y0 * SCALE}px;` +
          `width:${(r.x1 - r.x0 + 1) * SCALE}px;height:${(r.y1 - r.y0 + 1) * SCALE}px`;
        return box;
      }),
    );
  }

  // Chemical field: 1 inside each rectangle, falling off linearly with distance to 0 at
  // DITHER_RADIUS; overlapping rectangles take the maximum.
  function paintField() {
    rects = layoutRects();
    // Point each giant at its (possibly moved or resized) rectangle.
    if (giantIds.length === rects.length) giantIds.forEach((id, k) => giantRect.set(id, rects[k]));
    if (mode === 'debug') drawDebugBoxes(rects);
    const next = new Float32Array(C.grid._pixelArray.length);
    const R = DITHER_RADIUS;
    for (const r of rects) {
      for (let x = Math.max(0, r.x0 - R); x <= Math.min(W - 1, r.x1 + R); x++) {
        for (let y = Math.max(0, r.y0 - R); y <= Math.min(H - 1, r.y1 + R); y++) {
          const v = chemAtXY(r, x, y);
          const i = idx(x, y);
          if (v > next[i]) next[i] = v;
        }
      }
    }
    field = next;
  }

  function cornerRadius(r: Rect) {
    return Math.min(CORNER_RADIUS, (r.x1 - r.x0) / 2, (r.y1 - r.y0) / 2);
  }

  // Distance from (x, y) to the rounded rectangle r; 0 or less means inside.
  function roundedDistance(r: Rect, x: number, y: number) {
    const rc = cornerRadius(r);
    const dx = Math.max(r.x0 + rc - x, 0, x - (r.x1 - rc));
    const dy = Math.max(r.y0 + rc - y, 0, y - (r.y1 - rc));
    return Math.hypot(dx, dy) - rc;
  }

  // Chemical of rectangle r at (x, y): 1 inside, fading to 0 over DITHER_RADIUS outside.
  function chemAtXY(r: Rect, x: number, y: number) {
    const d = roundedDistance(r, x, y);
    if (d <= 0) return 1;
    return Math.max(0, 1 - d / DITHER_RADIUS);
  }

  // Chemical of rectangle r at grid index i.
  function chemAt(r: Rect, i: number) {
    const YB = C.grid.Y_BITS;
    return chemAtXY(r, i >> YB, i & ((1 << YB) - 1));
  }

  // Area of the rounded rectangle (each corner loses a square of side rc minus a quarter disc).
  function rectArea(r: Rect) {
    const rc = cornerRadius(r);
    return (r.x1 - r.x0 + 1) * (r.y1 - r.y0 + 1) - (4 - Math.PI) * rc * rc;
  }

  // Soft constraint for the giant cells: attraction to their own rectangle plus a volume term
  // with a per-cell target (the rectangle's area).
  function makeGiantConstraint() {
    return new (class GiantCells extends CPM.SoftConstraint {
      confChecker() {}
      deltaH(_src: number, tgt: number, srcType: number, tgtType: number) {
        let dH = 0;
        const gainer = giantRect.get(srcType);
        if (gainer) {
          const v = C.getVolume(srcType);
          const v0 = rectArea(gainer) * GIANT_VOLUME_FACTOR;
          dH += -CHEM_LAMBDA * chemAt(gainer, tgt);
          dH += GIANT_LAMBDA_V * ((v + 1 - v0) ** 2 - (v - v0) ** 2);
        }
        const loser = giantRect.get(tgtType);
        if (loser) {
          const v = C.getVolume(tgtType);
          const v0 = rectArea(loser) * GIANT_VOLUME_FACTOR;
          dH += CHEM_LAMBDA * chemAt(loser, tgt);
          dH += GIANT_LAMBDA_V * ((v - 1 - v0) ** 2 - (v - v0) ** 2);
        }
        return dH;
      }
    })({});
  }

  // One giant per rectangle, starting out filling it exactly.
  function seedGiants() {
    giantIds = [];
    giantRect.clear();
    for (const r of rects) {
      const id = C.makeNewCellID(GIANT);
      for (let x = r.x0; x <= r.x1; x++) {
        for (let y = r.y0; y <= r.y1; y++) if (roundedDistance(r, x, y) <= 0) C.setpixi(idx(x, y), id);
      }
      giantIds.push(id);
      giantRect.set(id, r);
    }
  }

  function seedCells() {
    let free = 0;
    for (let x = 0; x < W; x++) for (let y = 0; y < H; y++) if (C.pixti(idx(x, y)) === BG) free++;
    const n = Math.min(MAX_CELLS, Math.floor((free * DENSITY) / CONF.V[CELL]));
    for (let k = 0; k < n; k++) {
      for (let attempt = 0; attempt < 50; attempt++) {
        const x = Math.floor(Math.random() * W);
        const y = Math.floor(Math.random() * H);
        if (C.pixti(idx(x, y)) === BG) {
          seedDisc(x, y, C.makeNewCellID(CELL), CONF.V[CELL]);
          break;
        }
      }
    }
  }

  // Start a cell as a disc of (up to) the given area on free background sites, so it appears
  // at full size immediately instead of growing from a single pixel.
  function seedDisc(cx: number, cy: number, id: number, area: number) {
    const r = Math.sqrt(area / Math.PI);
    const ri = Math.ceil(r);
    for (let x = Math.max(0, cx - ri); x <= Math.min(W - 1, cx + ri); x++) {
      for (let y = Math.max(0, cy - ri); y <= Math.min(H - 1, cy + ri); y++) {
        const i = idx(x, y);
        if ((x - cx) ** 2 + (y - cy) ** 2 <= r * r && C.pixti(i) === BG) C.setpixi(i, id);
      }
    }
  }

  function build() {
    C = new CPM.CPM([W, H], { ...CONF, seed: Math.floor(Math.random() * 1e9) });
    C.add(makeGiantConstraint());
    attractor = new CPM.AttractionPointConstraint({
      LAMBDA_ATTRACTIONPOINT: [0, 0, 0],
      ATTRACTIONPOINT: [
        [NaN, NaN],
        [NaN, NaN],
        [0, 0],
      ],
    });
    C.add(attractor);
    paintField();
    seedGiants();
    seedCells();
    // Artistoo's Act constraint stores an activity entry for every pixel that was set, so
    // seeding fills it with tens of thousands of entries (mostly giant pixels, which have no
    // activity). Its first update then deletes them one by one, which takes seconds in Firefox.
    // Start with an empty store instead.
    const act = C.soft_constraints.find((c: any) => 'cellpixelsact' in c);
    if (act) act.cellpixelsact = {};
    if (mode === 'debug') {
      // inspect the model and the chemical field from the console
      (window as any).cpm = C;
      (window as any).cpmField = () => field;
    }
  }

  function measure() {
    return {
      w: Math.ceil(container.clientWidth / SCALE),
      h: Math.ceil(container.getBoundingClientRect().height / SCALE),
    };
  }

  function sync() {
    if (!simOn()) return; // switched off: nothing to measure until it is turned back on
    const { w, h } = measure();
    // The page has no size yet (hidden or background tab, window still opening): wait for the
    // resize observer to call again once it does.
    if (w < 2 || h < 2) {
      mark('waitingForSize');
      return;
    }
    if (!C || w !== W || h !== H) {
      W = w;
      H = h;
      canvas.width = W;
      canvas.height = H;
      canvas.style.width = `${W * SCALE}px`;
      canvas.style.height = `${H * SCALE}px`;
      image = ctx.createImageData(W, H);
      build();
      mark('built');
    } else {
      const count = giantIds.length;
      paintField();
      // Rebuild if elements appeared or disappeared, so every rectangle keeps exactly one giant.
      if (rects.length !== count) build();
    }
  }

  // ---- Drawing ----------------------------------------------------------------------------
  function readColors() {
    const root = getComputedStyle(document.documentElement);
    const hex = root.getPropertyValue('--accent').trim().replace('#', '');
    const muted = root.getPropertyValue('--muted').trim().replace('#', '');
    const rgb = (h: string) => [0, 2, 4].map((o) => parseInt(h.slice(o, o + 2), 16));
    const dark = document.documentElement.dataset.theme === 'dark';
    const a = rgb(hex);
    colors = {
      fill: [...a, dark ? 40 : 28],
      edge: [...a, dark ? 130 : 110],
      giantFill: [...rgb(muted), dark ? 22 : 14],
      giantEdge: [...rgb(muted), dark ? 110 : 90],
      field: [...rgb(muted), 0], // debug shading of the chemical field (alpha set per site)
    };
  }

  function draw() {
    if (!image) return;
    // Only redraw the rows that are on screen.
    const origin = layer.getBoundingClientRect();
    const y0 = Math.max(0, Math.floor(-origin.top / SCALE) - 2);
    const y1 = Math.min(H, Math.ceil((innerHeight - origin.top) / SCALE) + 2);
    if (y1 <= y0) return;

    const px = image.data;
    const grid = C.grid._pixelArray;
    const YB = C.grid.Y_BITS;
    const debug = mode === 'debug';

    for (let y = y0; y < y1; y++) {
      for (let x = 0; x < W; x++) {
        const t = grid[(x << YB) | y];

        let c = null;
        const i = (x << YB) | y;
        if (t !== BG) {
          const edge =
            (x > 0 && grid[((x - 1) << YB) | y] !== t) ||
            (x < W - 1 && grid[((x + 1) << YB) | y] !== t) ||
            (y > 0 && grid[(x << YB) | (y - 1)] !== t) ||
            (y < H - 1 && grid[(x << YB) | (y + 1)] !== t);
          const giant = giantRect.has(t);
          c = edge ? (giant ? colors.giantEdge : colors.edge) : giant ? colors.giantFill : colors.fill;
        } else if (debug && field[i] > 0) {
          c = colors.field;
          c[3] = Math.round(70 * field[i]);
        }
        const o = (y * W + x) * 4;
        if (c) {
          px[o] = c[0];
          px[o + 1] = c[1];
          px[o + 2] = c[2];
          px[o + 3] = c[3];
        } else {
          px[o + 3] = 0;
        }
      }
    }
    ctx.putImageData(image, 0, 0, 0, y0, W, y1 - y0);
  }

  // ---- Main loop --------------------------------------------------------------------------
  function frame() {
    if (!running) return;
    mark('firstRaf');
    if (C) {
      updateAttractor();
      mark('firstStepStart');
      for (let i = 0; i < MCS_PER_FRAME; i++) C.timeStep();
      mark('firstStepDone');
      draw();
      if (!('firstFrame' in timings)) {
        mark('firstFrame');
        if (mode === 'debug') console.info('[cpm] startup timings (ms since navigation):', timings);
      }
      canvas.style.opacity = '1';
    }
    requestAnimationFrame(frame);
  }

  async function start() {
    CPM = await loadArtistoo();
    mark('artistooLoaded');
    await document.fonts?.ready;
    mark('fontsReady');
    readColors();
    // Watch the content area from the start, so a page that has no size yet still gets set up
    // as soon as it is laid out.
    watch([container]);
    sync();

    new MutationObserver(readColors).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // It may have been switched off while the library was loading.
    if (simOn()) {
      mark('rafRequested');
      running = true;
      requestAnimationFrame(frame);
    }
  }

  // Point the attractor at the cursor (in lattice coordinates; recomputed every frame so it
  // follows scrolling too), or switch it off.
  function updateAttractor() {
    if (!attractor) return;
    const on = document.documentElement.dataset.attract === 'on' && pointer !== null;
    attractor.conf.LAMBDA_ATTRACTIONPOINT[CELL] = on ? ATTRACT_LAMBDA : 0;
    if (on) {
      const origin = layer.getBoundingClientRect();
      attractor.conf.ATTRACTIONPOINT[CELL] = [(pointer![0] - origin.left) / SCALE, (pointer![1] - origin.top) / SCALE];
    }
  }

  // Turn the simulation on or off to match data-sim.
  function applySimState() {
    if (simOn()) {
      layer.style.display = '';
      if (debugLayer) debugLayer.style.display = '';
      if (!started) {
        started = true;
        start();
      } else if (!running) {
        sync(); // the layout may have changed while it was off
        running = true;
        requestAnimationFrame(frame);
      }
    } else {
      running = false;
      layer.style.display = 'none';
      if (debugLayer) debugLayer.style.display = 'none';
    }
  }

  if (mode === 'debug') (window as any).cpmTimings = timings;
  new MutationObserver(applySimState).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-sim'],
  });
  applySimState();
</script>

