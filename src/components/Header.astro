---
import { NAV, SITE } from '../config';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="sim-wrap">
        <button id="sim-toggle" type="button" aria-label="Pause background animation" aria-pressed="true" title="Pause background animation">
          <!-- Pause while it runs, play while it is stopped -->
          <svg class="icon-sim-on" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="5" width="4" height="14" rx="1"></rect>
            <rect x="14" y="5" width="4" height="14" rx="1"></rect>
          </svg>
          <svg class="icon-sim-off" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path>
          </svg>
        </button>
        <!-- One-time hint, shown on a visitor's first visit (see the script below) -->
        <div id="sim-hint" class="sim-hint" role="status" hidden>
          <span>Click here to disable the cell simulation</span>
          <button type="button" class="sim-hint-close" aria-label="Dismiss">×</button>
        </div>
      </span>
      <button id="attract-toggle" type="button" aria-label="Cursor attracts cells" aria-pressed="false" title="Make the cursor attract cells">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="7"></circle>
          <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
        </svg>
      </button>
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  // Background simulation toggle: flips data-sim on <html> (CpmBackground listens for it) and
  // remembers the choice.
  const simButton = document.getElementById('sim-toggle');
  const syncSimButton = () => {
    const on = document.documentElement.dataset.sim !== 'off';
    const label = on ? 'Pause background animation' : 'Play background animation';
    simButton?.setAttribute('aria-pressed', String(on));
    simButton?.setAttribute('aria-label', label);
    simButton?.setAttribute('title', label);
  };

  // First-visit hint next to the pause button. Shown once (remembered in localStorage), only
  // while the simulation is running; closed by its × button, Escape, or using the pause button.
  const hint = document.getElementById('sim-hint');
  const hintSeen = () => {
    try {
      return localStorage.getItem('simHint') === 'seen';
    } catch {
      return true; // no storage: don't risk showing it on every page
    }
  };
  const dismissHint = () => {
    if (!hint || hint.hidden) return;
    hint.hidden = true;
    try {
      localStorage.setItem('simHint', 'seen');
    } catch {}
  };
  if (hint && !hintSeen()) {
    setTimeout(() => {
      if (!hintSeen() && document.documentElement.dataset.sim !== 'off') hint.hidden = false;
    }, 1200);
  }
  hint?.querySelector('.sim-hint-close')?.addEventListener('click', dismissHint);
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dismissHint();
  });
  // Cursor-attractor toggle: flips data-attract on <html>; only usable while the simulation is on.
  const attractButton = document.getElementById('attract-toggle') as HTMLButtonElement | null;
  const syncAttractButton = () => {
    const on = document.documentElement.dataset.attract === 'on';
    attractButton?.setAttribute('aria-pressed', String(on));
    attractButton?.setAttribute('title', on ? 'Stop the cursor attracting cells' : 'Make the cursor attract cells');
    if (attractButton) attractButton.disabled = document.documentElement.dataset.sim === 'off';
  };
  syncAttractButton();
  attractButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.attract === 'on' ? 'off' : 'on';
    document.documentElement.dataset.attract = next;
    try {
      localStorage.setItem('attract', next);
    } catch {}
    syncAttractButton();
  });

  syncSimButton();
  simButton?.addEventListener('click', () => {
    const next = document.documentElement.dataset.sim === 'off' ? 'on' : 'off';
    document.documentElement.dataset.sim = next;
    try {
      localStorage.setItem('sim', next);
    } catch {}
    syncSimButton();
    syncAttractButton();
    dismissHint();
  });

  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    padding: 1rem 1.25rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  #theme-toggle,
  #sim-toggle,
  #attract-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  #theme-toggle:hover,
  #sim-toggle:hover,
  #attract-toggle:hover {
    color: var(--text);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-moon {
    display: block;
  }

  #attract-toggle[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  #attract-toggle:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .icon-sim-off {
    display: none;
  }

  :global([data-sim='off']) .icon-sim-on {
    display: none;
  }

  :global([data-sim='off']) .icon-sim-off {
    display: block;
  }

  .sim-wrap {
    position: relative;
    display: inline-flex;
  }

  .sim-hint {
    position: absolute;
    top: calc(100% + 10px);
    right: -6px;
    z-index: 1100;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2.5rem));
    padding: 0.55rem 0.6rem 0.55rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.85rem;
    line-height: 1.4;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
  }

  .sim-hint[hidden] {
    display: none;
  }

  /* little arrow pointing up at the button */
  .sim-hint::before {
    content: '';
    position: absolute;
    top: -6px;
    right: 16px;
    width: 10px;
    height: 10px;
    background: var(--bg);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
    transform: rotate(45deg);
  }

  .sim-hint-close {
    flex-shrink: 0;
    border: none;
    background: none;
    padding: 0 0.15rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .sim-hint-close:hover {
    color: var(--text);
  }
</style>
