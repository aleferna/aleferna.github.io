---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config';

interface Props {
  pub: CollectionEntry<'publications'>;
}

const { pub } = Astro.props;
const { title, authors, venue, year, note, links } = pub.data;

const linkList = [
  { label: 'PDF', href: links.pdf },
  { label: 'DOI', href: links.doi && (links.doi.startsWith('http') ? links.doi : `https://doi.org/${links.doi}`) },
  { label: 'arXiv', href: links.arxiv && (links.arxiv.startsWith('http') ? links.arxiv : `https://arxiv.org/abs/${links.arxiv}`) },
  { label: 'Code', href: links.code },
  { label: 'Slides', href: links.slides },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
---

<li class="pub">
  <div class="title">{title}</div>
  <div class="authors">
    {
      authors.map((author, i) => (
        <>
          {author === SITE.authorName ? <strong>{author}</strong> : author}
          {i < authors.length - 1 ? ', ' : ''}
        </>
      ))
    }
  </div>
  <div class="venue"><em>{venue}</em>, {year}{note && <span class="note"> · {note}</span>}</div>
  {
    linkList.length > 0 && (
      <div class="links">
        {linkList.map(({ label, href }) => (
          <a href={href}>{label}</a>
        ))}
      </div>
    )
  }
</li>

<style>
  .pub {
    margin: 0 0 calc(2.25rem + 65px);
  }

  .title {
    font-weight: 600;
    line-height: 1.4;
  }

  .authors,
  .venue {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .note {
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }

  .links a {
    font-size: 0.8rem;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.45rem;
  }

  .links a:hover {
    border-color: var(--accent);
  }
</style>
